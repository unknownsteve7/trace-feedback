# TRACE Feedback Service Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database connection:
# Default standalone: SQLite async
DATABASE_URL=sqlite+aiosqlite:///./feedback.db

# Or connect directly to TRACE PostgreSQL:
